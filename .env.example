# ---------------------------------------------------------------------------
# VibeSec Security Health — environment variables
# Copy to .env.local for local development. Set the same keys in Vercel.
# NEVER commit real values. Only NEXT_PUBLIC_* variables are exposed to browsers.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Public URL of the deployed site (used in emails, report links, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret (32+ chars) used to salt IP-address hashes. e.g. `openssl rand -hex 32`
IP_HASH_SALT=

# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to /api/cron/retention
CRON_SECRET=

# --- Business contact defaults (can be overridden in Admin → Settings) -------
NEXT_PUBLIC_VIBESEC_EMAIL=
NEXT_PUBLIC_VIBESEC_WHATSAPP=
NEXT_PUBLIC_VIBESEC_WEBSITE=
NEXT_PUBLIC_BOOKING_URL=

# --- Email (optional; emails are skipped when unset) -------------------------
RESEND_API_KEY=
# Verified sender in Resend, e.g. "security@yourdomain.com" (or set in Admin → Settings)
EMAIL_FROM=
# Receives consultation requests and Priority A/B lead alerts
ADMIN_NOTIFICATION_EMAIL=

# --- Bot protection (optional but recommended in production) -----------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (optional; falls back to the Postgres limiter) ------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tuning (optional) ---------------------------------------------------------
# Max simultaneous scans across the deployment (default 10)
MAX_CONCURRENT_SCANS=10
# Report link lifetime in days (default 90)
REPORT_TOKEN_TTL_DAYS=90
